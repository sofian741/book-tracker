{
  "name": "book-tracker",
  "version": "1.0.4",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "cap:sync": "npm run build && cap sync android",
    "test:ui": "npm run build && playwright test",
    "start": "npm run build && vite preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.0",
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/filesystem": "^7.1.0",
    "@capacitor/share": "^7.0.0",
    "@fontsource/noto-sans-arabic": "^5.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@playwright/test": "^1.65.0",
    "prettier": "^3.9.10",
    "vite": "^6.1.0"
  }
}
